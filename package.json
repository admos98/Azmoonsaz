{
  "name": "examforge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "check:bundle": "node tools/check-bundle.mjs",
    "check:theme": "node tools/check-theme-tokens.mjs",
    "check:typography": "node tools/check-typography.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check": "npm run typecheck && npm run lint && npm run check:theme && npm run check:typography && npm run check:a11y-buttons && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node tools/check-env.mjs",
    "hash:national-id": "node tools/hash-national-id.mjs",
    "dev:vercel": "npx vercel dev",
    "supabase:smoke": "node tools/supabase-smoke-test.mjs",
    "seed:demo-sql": "node tools/generate-demo-seed-sql.mjs",
    "dev:api": "npx vercel dev --listen 3001",
    "verify:prod": "node tools/verify-production-safety.mjs",
    "deploy:check": "node tools/deploy-readiness.mjs",
    "cleanup:generated": "node tools/cleanup-generated.mjs",
    "predeploy": "npm run lint && npm run build && npm run verify:prod && npm run deploy:check",
    "test:e2e": "npx playwright test",
    "check:a11y-buttons": "node tools/check-icon-buttons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.4.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "6.2.3",
    "vitest": "^4.1.11"
  }
}
