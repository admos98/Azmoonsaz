# Public browser-safe values. These are allowed to be exposed in the Vite bundle.
VITE_APP_URL="http://localhost:3000"
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_ENABLE_MOCK_MODE="false"

# Server-only values. NEVER prefix these with VITE_ and NEVER use them in src/ browser code.
# Use only in Vercel API functions, Supabase Edge Functions, or other backend code.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY"
STUDENT_ID_PEPPER="GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES"
APP_URL="http://localhost:3000"

# Optional AI grading. Server-only. Never expose to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_SERVER_ONLY"

# Image store provider. "supabase" (default) uses the private Supabase
# Storage bucket. "s3" uses any SigV4 S3-compatible store (Parspack,
# ArvanCloud) — active ONLY when all four S3_* vars below are set, otherwise
# the server logs once and stays on Supabase. No key in Vercel = no change.
#IMAGE_STORE_PROVIDER="supabase"
#S3_ENDPOINT="https://s3.parspack.com"
#S3_ACCESS_KEY="YOUR_S3_ACCESS_KEY_SERVER_ONLY"
#S3_SECRET_KEY="YOUR_S3_SECRET_KEY_SERVER_ONLY"
#S3_BUCKET="examforge-images"
#S3_REGION="default"
#S3_FORCE_PATH_STYLE="true"
# When you flip to S3, also extend the Content-Security-Policy in vercel.json:
# connect-src AND img-src must include your S3 origin (direct browser PUT +
# <img> loads), otherwise uploads and rendering are blocked. Supabase needs
# no change — *.supabase.co is already allowed.
